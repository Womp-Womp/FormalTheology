 "verses": {
  "bsb|EXO 3:6": {
   "text": "Then He said, “I am the God of your father, the God of Abraham, the God of Isaac, and the God of Jacob.” At this, Moses hid his face, for he was afraid to look at God."
  },
  "bsb|GEN 25:8": {
   "text": "And at a ripe old age he breathed his last and died, old and contented, and was gathered to his people."
  },
  "bsb|MAT 22:31": {
   "text": "But concerning the resurrection of the dead, have you not read what God said to you:"
  },
  "bsb|MAT 22:32": {
   "text": "‘I am the God of Abraham, the God of Isaac, and the God of Jacob’? He is not the God of the dead, but of the living.”"
  },
