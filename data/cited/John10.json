   "marked": "The Jews answered him, saying, For a good work we stone thee not; but for blasphemy; and because that thou, being a man, makest thyself God.",
   "text": "The Jews answered him, saying, For a good work we stone thee not; but for blasphemy; and because that thou, being a man, makest thyself God."
  },
  "kjv|JHN 10:34": {
   "marked": "Jesus answered them, Is it not written in your law, I said, Ye are gods?",
   "text": "Jesus answered them, Is it not written in your law, I said, Ye are gods?"
  },
  "kjv|JHN 10:35": {
   "marked": "If he called them gods, unto whom the word of God came, and the scripture cannot be broken;",
   "text": "If he called them gods, unto whom the word of God came, and the scripture cannot be broken;"
  },
  "kjv|JHN 10:36": {
   "marked": "Say ye of him, whom the Father hath sanctified, and sent into the world, Thou blasphemest; because I said, I am the Son of God?",
   "text": "Say ye of him, whom the Father hath sanctified, and sent into the world, Thou blasphemest; because I said, I am the Son of God?"
  },
  "kjv|PSA 82:6": {
   "marked": "I have said, Ye [are] gods; and all of you [are] children of the most High.",
   "text": "I have said, Ye are gods; and all of you are children of the most High."
  },
  "lat|JHN 10:33": {
   "text": "Responderunt ei Judæi: De bono opere non lapidamus te, sed de blasphemia; et quia tu homo cum sis, facis teipsum Deum."
  },
  "lat|JHN 10:34": {
   "text": "Respondit eis Jesus: Nonne scriptum est in lege vestra, Quia ego dixi: Dii estis?"
  },
  "lat|JHN 10:35": {
   "text": "Si illos dixit deos, ad quos sermo Dei factus est, et non potest solvi Scriptura:"
  },
  "lat|JHN 10:36": {
   "text": "quem Pater sanctificavit, et misit in mundum vos dicitis: Quia blasphemas, quia dixi: Filius Dei sum?"
  },
  "lat|PSA 81:6": {
   "text": "Ego dixi: Dii estis, et filii Excelsi omnes."
  },
  "lat|PSA 82:6": {
   "text": "Quoniam cogitaverunt unanimiter; simul adversum te testamentum disposuerunt:"
  }
