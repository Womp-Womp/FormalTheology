 "verses": {
  "bsb|MAT 1:1": {
   "text": "This is the record of the genealogy of Jesus Christ, the son of David, the son of Abraham:"
  },
  "bsb|MAT 22:42": {
   "text": "“What do you think about the Christ? Whose son is He?” “David’s,” they answered."
  },
  "bsb|MAT 22:43": {
   "text": "Jesus said to them, “How then does David in the Spirit call Him ‘Lord’? For he says:"
  },
  "bsb|MAT 22:44": {
   "text": "‘The Lord said to my Lord, “Sit at My right hand until I put Your enemies under Your feet.”’"
  },
  "bsb|MAT 22:45": {
   "text": "So if David calls Him ‘Lord,’ how can He be David’s son?”"
  },
  "bsb|PSA 110:1": {
   "text": "A Psalm of David. The LORD said to my Lord: “Sit at My right hand until I make Your enemies a footstool for Your feet.”"
  },
