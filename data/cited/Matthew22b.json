   "text": "The book of the generation of Jesus Christ, the son of David, the son of Abraham."
  },
  "kjv|MAT 22:42": {
   "marked": "Saying, What think ye of Christ? whose son is he? They say unto him, [The Son] of David.",
   "text": "Saying, What think ye of Christ? whose son is he? They say unto him, The Son of David."
  },
  "kjv|MAT 22:43": {
   "marked": "He saith unto them, How then doth David in spirit call him Lord, saying,",
   "text": "He saith unto them, How then doth David in spirit call him Lord, saying,"
  },
  "kjv|MAT 22:44": {
   "marked": "The LORD said unto my Lord, Sit thou on my right hand, till I make thine enemies thy footstool?",
   "text": "The LORD said unto my Lord, Sit thou on my right hand, till I make thine enemies thy footstool?"
  },
  "kjv|MAT 22:45": {
   "marked": "If David then call him Lord, how is he his son?",
   "text": "If David then call him Lord, how is he his son?"
  },
  "kjv|PSA 110:1": {
   "marked": "A Psalm of David. The LORD said unto my Lord, Sit thou at my right hand, until I make thine enemies thy footstool.",
   "text": "A Psalm of David. The LORD said unto my Lord, Sit thou at my right hand, until I make thine enemies thy footstool."
  },
  "lat|MAT 1:1": {
   "text": "Liber generationis Jesu Christi filii David, filii Abraham."
  },
  "lat|MAT 22:42": {
   "text": "dicens: Quid vobis videtur de Christo? cujus filius est? Dicunt ei: David."
  },
  "lat|MAT 22:43": {
   "text": "Ait illis: Quomodo ergo David in spiritu vocat eum Dominum, dicens:"
  },
  "lat|MAT 22:44": {
   "text": "Dixit Dominus Domino meo: Sede a dextris meis, donec ponam inimicos tuos scabellum pedum tuorum?"
  },
  "lat|MAT 22:45": {
   "text": "Si ergo David vocat eum Dominum, quomodo filius ejus est?"
  },
  "lat|PSA 109:1": {
   "text": "Psalmus David. [Dixit Dominus Domino meo: Sede a dextris meis, donec ponam inimicos tuos scabellum pedum tuorum."
  },
  "lat|PSA 110:1": {
   "text": "Alleluja. [Confitebor tibi, Domine, in toto corde meo, in consilio justorum, et congregatione."
