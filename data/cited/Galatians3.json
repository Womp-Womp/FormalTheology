 "verses": {
  "bsb|EXO 12:40": {
   "text": "Now the duration of the Israelites’ stay in Egypt was 430 years."
  },
  "bsb|GAL 3:15": {
   "text": "Brothers, let me put this in human terms. Even a human covenant, once it is ratified, cannot be canceled or amended."
  },
  "bsb|GAL 3:16": {
   "text": "The promises were spoken to Abraham and to his seed. The Scripture does not say, “and to seeds,” meaning many, but “and to your seed,” meaning One, who is Christ."
  },
  "bsb|GAL 3:17": {
   "text": "What I mean is this: The law that came 430 years later does not revoke the covenant previously established by God, so as to nullify the promise."
  },
  "bsb|GAL 3:18": {
   "text": "For if the inheritance depends on the law, then it no longer depends on a promise; but God freely granted it to Abraham through a promise."
  },
  "bsb|GEN 13:15": {
   "text": "for all the land that you see, I will give to you and your offspring forever."
  },
