  "kjv|MRK 3:22": {
   "marked": "¶ And the scribes which came down from Jerusalem said, He hath Beelzebub, and by the prince of the devils casteth he out devils.",
   "text": "¶ And the scribes which came down from Jerusalem said, He hath Beelzebub, and by the prince of the devils casteth he out devils."
  },
  "kjv|MRK 3:23": {
   "marked": "And he called them [unto him], and said unto them in parables, How can Satan cast out Satan?",
   "text": "And he called them unto him, and said unto them in parables, How can Satan cast out Satan?"
  },
  "kjv|MRK 3:24": {
   "marked": "And if a kingdom be divided against itself, that kingdom cannot stand.",
   "text": "And if a kingdom be divided against itself, that kingdom cannot stand."
  },
  "kjv|MRK 3:25": {
   "marked": "And if a house be divided against itself, that house cannot stand.",
   "text": "And if a house be divided against itself, that house cannot stand."
  },
  "kjv|MRK 3:26": {
   "marked": "And if Satan rise up against himself, and be divided, he cannot stand, but hath an end.",
   "text": "And if Satan rise up against himself, and be divided, he cannot stand, but hath an end."
  },
  "kjv|MRK 3:27": {
   "marked": "No man can enter into a strong man’s house, and spoil his goods, except he will first bind the strong man; and then he will spoil his house.",
   "text": "No man can enter into a strong man’s house, and spoil his goods, except he will first bind the strong man; and then he will spoil his house."
  },
  "lat|MRK 3:22": {
   "text": "Et scribæ, qui ab Jerosolymis descenderant, dicebant: Quoniam Beelzebub habet, et quia in principe dæmoniorum ejicit dæmonia."
  },
  "lat|MRK 3:23": {
   "text": "Et convocatis eis in parabolis dicebat illis: Quomodo potest Satanas Satanam ejicere?"
  },
  "lat|MRK 3:24": {
   "text": "Et si regnum in se dividatur, non potest regnum illud stare."
  },
  "lat|MRK 3:25": {
   "text": "Et si domus super semetipsam dispertiatur, non potest domus illa stare."
  },
  "lat|MRK 3:26": {
   "text": "Et si Satanas consurrexerit in semetipsum, dispertitus est, et non poterit stare, sed finem habet."
  },
  "lat|MRK 3:27": {
   "text": "Nemo potest vasa fortis ingressus in domum diripere, nisi prius fortem alliget, et tunc domum ejus diripiet."
  }
